DATA_SOURCE=postgres

# 1 = login local sem Supabase (fundadores / demo). Tire quando o Auth do Supabase estiver no ar.
# GRID_MOCK_AUTH=1

# Projeto: https://smroraizzrbbrkwpaukh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://smroraizzrbbrkwpaukh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (Open Graph, auth callback, Stripe).
# Local: http://localhost:3000
# Produção: https://grid.mundopodium.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct connection (porta 5432) — NÃO use o pooler 6543
# postgresql://postgres.[SENHA]@db.smroraizzrbbrkwpaukh.supabase.co:5432/postgres?sslmode=require
# Session pooler (*.pooler.supabase.com:5432) caps at ~15 clients — pools shrink automatically.
# PG_POOL_MAX=2
#
# Docker local (opcional, só dev/offline):
# docker compose up -d → postgresql://grid:grid@127.0.0.1:5432/grid
DATABASE_URL=
RF_CNPJ_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/

# Selos CONFIRMADO/ATUALIZADO sorteados — só com DATA_SOURCE=mock e nunca em prod
# MOCK_PREVIEW_SEALS=1

# Busca de domínio (opcional). Sem chave, o worker usa só o e-mail da Receita.
# SERPER_API_KEY=

# Checklist: pnpm launch:check · pnpm launch:ready · pnpm db:verify-rf
# Phone-sharing real: pnpm validate:phones  (mock: --allow-mock)

# Worker: busca (default 2) tem slots próprios; enrich no lançamento use 3.
# SEARCH_JOB_CONCURRENCY=2
# ENRICH_CONCURRENCY=3

# Dump Docker → Supabase
# SUPABASE_DB_URL=postgresql://postgres.[SENHA]@db.smroraizzrbbrkwpaukh.supabase.co:5432/postgres?sslmode=require

# Cobrança — sem chaves, o checkout usa o provider mock (demo)
# BILLING_STORE=memory
# Cupom que libera o plano Membro da Plataforma (nível Piloto incluso)
BILLING_PLATFORM_COUPON=PILOTOPODIUM

# Atendimento WhatsApp (E.164 sem +, ou DDD+número). Sem isso, o CTA some e fica só a FAQ.
NEXT_PUBLIC_SUPPORT_WHATSAPP=5531953491412

# Asaas (Pix, cartão BR, boleto, assinatura)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Stripe (cartão internacional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Circle Mint (tesouraria — não aparece no checkout)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_PIX_ACCOUNT_ID=
# CIRCLE_WEBHOOK_SECRET=
# CIRCLE_API_BASE=https://api.circle.com
# CIRCLE_SWEEP_MIN_CENTS=1

# Cache + rate limit (Upstash Redis — recomendado em prod; fallback in-memory em dev)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Admin — curadoria de nichos (/admin/nichos). Obrigatório em produção.
# GRID_ADMIN_EMAILS=founder@mundopodium.com.br

# Criptografia de credenciais de integração (32+ chars aleatórios). Obrigatório em produção.
# INTEGRATION_KMS_KEY=

# Marca deploy de produção (ativa checks em webhooks/worker). Vercel define VERCEL_ENV=production.
# GRID_ENV=production

# Checklist pré-lançamento: pnpm launch:check
# Webhooks billing (registrar nos dashboards):
#   {NEXT_PUBLIC_SITE_URL}/api/billing/webhooks/asaas
#   {NEXT_PUBLIC_SITE_URL}/api/billing/webhooks/stripe
#   {NEXT_PUBLIC_SITE_URL}/api/billing/webhooks/circle
# Worker (Railway/Fly): mesmo DATABASE_URL + DATA_SOURCE=postgres → pnpm worker:dev
